# ---- Azure AI Search (leave these two as they are to run in offline demo mode) ----
SEARCH_ENDPOINT=https://YOUR-SEARCH-NAME.search.windows.net
SEARCH_KEY=paste-your-QUERY-key-here

# ---- Only for load_faq.py (creates the index). Never upload this to GitHub. ----
SEARCH_ADMIN_KEY=paste-your-ADMIN-key-here

# ---- Optional: Urdu answers (Azure Translator) ----
TRANSLATOR_KEY=
TRANSLATOR_REGION=eastus
